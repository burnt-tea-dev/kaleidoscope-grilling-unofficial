        "tp_left": "animation.kg_a287.skewer_tp_left"
      },
      "scripts": {
        "initialize": [
          "v.kg_failure_source = 0;",
          "v.kg_failure_state = 0;",
          "v.kg_failure_helper_index = 0;",
          "v.kg_failure_ready = 0;",
          "v.kg_failure_helper_visible = 0;",
          "v.kg_bite_stage = 0;"
        ],
        "pre_animation": [
          "v.kg_failure_source = math.floor(math.clamp((c.item_slot == 'off_hand' ? (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_off_0') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_off_0') : 0) : (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_main_0') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_main_0') : 0)),0,19));",
          "v.kg_failure_state = math.floor(math.clamp((c.item_slot == 'off_hand' ? (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_off_1') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_off_1') : 0) : (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_main_1') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_main_1') : 0)),0,63));",
          "v.kg_failure_helper_index = math.floor(math.clamp((c.item_slot == 'off_hand' ? (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_off_2') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_off_2') : 0) : (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_main_2') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_main_2') : 0)),0,225));",
          "v.kg_failure_ready = ((c.item_slot == 'main_hand' && c.owning_entity->q.is_item_name_any('slot.weapon.mainhand','kaleidoscope_grilling:dark_grilling_native_plain')) || (c.item_slot == 'off_hand' && c.owning_entity->q.is_item_name_any('slot.weapon.offhand','kaleidoscope_grilling:dark_grilling_native_plain'))) && (c.item_slot == 'off_hand' ? (c.owning_entity->q.has_property('kaleidoscope_grilling:secret_off_piece') ? c.owning_entity->q.property('kaleidoscope_grilling:secret_off_piece') : 0) : (c.owning_entity->q.has_property('kaleidoscope_grilling:secret_main_piece') ? c.owning_entity->q.property('kaleidoscope_grilling:secret_main_piece') : 0)) == 220;",
          "v.kg_failure_helper_visible = 0;",
          "v.kg_bite_stage = 0;"
        ],
        "animate": [
          {
            "fp_right": "c.is_first_person == 1 && c.item_slot == 'main_hand'"
          },
          {
            "fp_left": "c.is_first_person == 1 && c.item_slot == 'off_hand'"
          },
          {
            "tp_right": "c.is_first_person == 0 && c.item_slot == 'main_hand'"
          },
          {
            "tp_left": "c.is_first_person == 0 && c.item_slot == 'off_hand'"
          }
        ]
      },
      "render_controllers": [
        "controller.render.kg_failure_held.dark_grilling"
      ]
