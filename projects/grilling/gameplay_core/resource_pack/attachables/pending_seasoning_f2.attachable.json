          "v.kg_bottle_owner_ready = 0;",
          "v.kg_bottle_layer_0 = 0;",
          "v.kg_bottle_layer_1 = 0;",
          "v.kg_bottle_layer_2 = 0;",
          "v.kg_bottle_layer_3 = 0;",
          "v.kg_bottle_layer_4 = 0;",
          "v.kg_bottle_layer_5 = 0;",
          "v.kg_bottle_layer_6 = 0;",
          "v.kg_bottle_layer_7 = 0;",
          "v.kg_season_season_hand = 0;",
          "v.kg_season_season_phase = 0;",
          "v.kg_season_pending_hand = 0;"
        ],
        "pre_animation": [
          "v.kg_bottle_off_hand = c.item_slot == 'off_hand';",
          "v.kg_bottle_owner_ready = ((c.item_slot == 'main_hand' && c.owning_entity->q.is_item_name_any('slot.weapon.mainhand','kaleidoscope_grilling:pending_seasoning_f2')) || (c.item_slot == 'off_hand' && c.owning_entity->q.is_item_name_any('slot.weapon.offhand','kaleidoscope_grilling:pending_seasoning_f2'))) && (c.item_slot == 'off_hand' ? (c.owning_entity->q.has_property('kaleidoscope_grilling:secret_off_piece') ? c.owning_entity->q.property('kaleidoscope_grilling:secret_off_piece') : 0) : (c.owning_entity->q.has_property('kaleidoscope_grilling:secret_main_piece') ? c.owning_entity->q.property('kaleidoscope_grilling:secret_main_piece') : 0)) == 214;",
          "v.kg_bottle_layer_0 = v.kg_bottle_owner_ready ? math.floor(math.clamp((v.kg_bottle_off_hand ? (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_off_0') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_off_0') : 0) : (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_main_0') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_main_0') : 0)), 0, 9)) : 0;",
          "v.kg_bottle_layer_1 = v.kg_bottle_owner_ready ? math.floor(math.clamp((v.kg_bottle_off_hand ? (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_off_1') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_off_1') : 0) : (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_main_1') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_main_1') : 0)), 0, 9)) : 0;",
          "v.kg_bottle_layer_2 = v.kg_bottle_owner_ready ? math.floor(math.clamp((v.kg_bottle_off_hand ? (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_off_2') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_off_2') : 0) : (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_main_2') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_main_2') : 0)), 0, 9)) : 0;",
          "v.kg_bottle_layer_3 = v.kg_bottle_owner_ready ? math.floor(math.clamp((v.kg_bottle_off_hand ? (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_off_3') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_off_3') : 0) : (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_main_3') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_main_3') : 0)), 0, 9)) : 0;",
          "v.kg_bottle_layer_4 = v.kg_bottle_owner_ready ? math.floor(math.clamp((v.kg_bottle_off_hand ? (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_off_4') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_off_4') : 0) : (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_main_4') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_main_4') : 0)), 0, 9)) : 0;",
          "v.kg_bottle_layer_5 = v.kg_bottle_owner_ready ? math.floor(math.clamp((v.kg_bottle_off_hand ? (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_off_5') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_off_5') : 0) : (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_main_5') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_main_5') : 0)), 0, 9)) : 0;",
          "v.kg_bottle_layer_6 = v.kg_bottle_owner_ready ? math.floor(math.clamp((v.kg_bottle_off_hand ? (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_off_6') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_off_6') : 0) : (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_main_6') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_main_6') : 0)), 0, 9)) : 0;",
          "v.kg_bottle_layer_7 = v.kg_bottle_owner_ready ? math.floor(math.clamp((v.kg_bottle_off_hand ? (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_off_7') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_off_7') : 0) : (c.owning_entity->q.has_property('kaleidoscope_grilling:bottle_main_7') ? c.owning_entity->q.property('kaleidoscope_grilling:bottle_main_7') : 0)), 0, 9)) : 0;",
          "v.kg_season_season_hand = (c.owning_entity->q.has_property('kaleidoscope_grilling:season_hand') ? c.owning_entity->q.property('kaleidoscope_grilling:season_hand') : 0);",
          "v.kg_season_season_phase = (c.owning_entity->q.has_property('kaleidoscope_grilling:season_phase') ? c.owning_entity->q.property('kaleidoscope_grilling:season_phase') : 0);",
          "v.kg_season_pending_hand = (c.owning_entity->q.has_property('kaleidoscope_grilling:pending_hand') ? c.owning_entity->q.property('kaleidoscope_grilling:pending_hand') : 0);"
        ]
      }
    }
  }
