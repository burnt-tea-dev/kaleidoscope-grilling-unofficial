        "default": "textures/held/bottle_shell_palette"
      },
      "geometry": {
        "default": "geometry.kg_bottle_held.combined"
      },
      "render_controllers": [
        "controller.render.kg_bottle_held.dynamic"
      ],
      "animations": {
