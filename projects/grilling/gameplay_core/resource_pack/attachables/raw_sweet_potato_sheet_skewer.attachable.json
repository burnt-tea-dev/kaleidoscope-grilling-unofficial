{
  "format_version": "1.26.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "kaleidoscope_grilling:raw_sweet_potato_sheet_skewer",
      "materials": {
        "default": "entity_alphatest_one_sided"
      },
      "textures": {
        "stage0": "textures/a22_bites/raw_sweet_potato_sheet_skewer_stage0",
        "stage1": "textures/a22_bites/raw_sweet_potato_sheet_skewer_stage1",
        "stage2": "textures/a22_bites/raw_sweet_potato_sheet_skewer_stage2",
        "stage3": "textures/a22_bites/raw_sweet_potato_sheet_skewer_stage2",
        "stage4": "textures/a22_bites/raw_sweet_potato_sheet_skewer_stage2"
      },
      "geometry": {
        "stage0": "geometry.kg_a287.kg_a22.raw_sweet_potato_sheet_skewer.stage0",
        "stage1": "geometry.kg_a287.kg_a22.raw_sweet_potato_sheet_skewer.stage1",
        "stage2": "geometry.kg_a287.kg_a22.raw_sweet_potato_sheet_skewer.stage2",
        "stage3": "geometry.kg_a287.kg_a22.raw_sweet_potato_sheet_skewer.stage2",
        "stage4": "geometry.kg_a287.kg_a22.raw_sweet_potato_sheet_skewer.stage2"
      },
      "scripts": {
        "pre_animation": [
          "v.kg_owner_eat_profile = (c.owning_entity->q.has_property('kaleidoscope_grilling:eat_profile') ? c.owning_entity->q.property('kaleidoscope_grilling:eat_profile') : 0);",
          "v.kg_owner_eat_hand = (c.owning_entity->q.has_property('kaleidoscope_grilling:eat_hand') ? c.owning_entity->q.property('kaleidoscope_grilling:eat_hand') : 0);",
          "v.kg_owner_eat_projection = (c.owning_entity->q.has_property('kaleidoscope_grilling:eat_projection') ? c.owning_entity->q.property('kaleidoscope_grilling:eat_projection') : 0);",
          "v.kg_owner_eat_native_ticks = (c.owning_entity->q.has_property('kaleidoscope_grilling:eat_native_ticks') ? c.owning_entity->q.property('kaleidoscope_grilling:eat_native_ticks') : 0);",
          "v.kg_owner_eat_elapsed_ticks = (c.owning_entity->q.has_property('kaleidoscope_grilling:eat_elapsed_ticks') ? c.owning_entity->q.property('kaleidoscope_grilling:eat_elapsed_ticks') : 0);",
          "v.kg_eat_seconds = (c.is_first_person == 1 ? (q.is_using_item && v.kg_owner_eat_hand == 2 ? (v.kg_owner_eat_native_ticks > 0 && v.kg_owner_eat_hand > 0 ? math.clamp(v.kg_owner_eat_elapsed_ticks / 20.0, 0, v.kg_owner_eat_native_ticks / 20.0) : 0) : (q.is_using_item && v.kg_owner_eat_native_ticks > 0 ? math.clamp((v.kg_owner_eat_native_ticks - (q.main_hand_item_use_duration - q.frame_alpha + 1.0)) / 20.0, 0, v.kg_owner_eat_native_ticks / 20.0) : 0)) : (v.kg_owner_eat_native_ticks > 0 && v.kg_owner_eat_hand > 0 ? math.clamp(v.kg_owner_eat_elapsed_ticks / 20.0, 0, v.kg_owner_eat_native_ticks / 20.0) : 0));",
          "v.kg_active_slot = (c.item_slot == 'main_hand' && v.kg_owner_eat_hand == 1) || (c.item_slot == 'off_hand' && v.kg_owner_eat_hand == 2);",
          "v.kg_same_item = c.item_slot == 'main_hand' ? q.is_item_name_any('slot.weapon.mainhand','kaleidoscope_grilling:raw_sweet_potato_sheet_skewer') : q.is_item_name_any('slot.weapon.offhand','kaleidoscope_grilling:raw_sweet_potato_sheet_skewer');",
          "v.kg_using_owned = q.is_using_item && v.kg_active_slot && v.kg_same_item && v.kg_owner_eat_profile == 2;",
          "v.kg_bite_ticks = c.is_first_person == 1 && c.item_slot == 'main_hand' ? math.clamp(v.kg_owner_eat_native_ticks - q.main_hand_item_use_duration - 1, 0, v.kg_owner_eat_native_ticks) : v.kg_owner_eat_elapsed_ticks;",
          "v.kg_bite_stage = v.kg_using_owned ? (v.kg_bite_ticks >= 80 ? 2 : (v.kg_bite_ticks >= 20 ? 1 : 0)) : 0;",
          "v.kg_source_projection = c.is_first_person == 1 && v.kg_using_owned && v.kg_owner_eat_projection == 1 && q.is_sneaking == 0 && q.is_swimming == 0 && q.is_gliding == 0 && q.is_riding == 0;",
          "v.kg_source_piece_scale = 0;",
          "v.kg_java_piece_visible = v.kg_source_projection && v.kg_source_piece_scale > 0.001;"
        ],
        "animate": [
          {
            "fp_right": "c.is_first_person == 1 && c.item_slot == 'main_hand' && !v.kg_source_projection"
          },
          {
            "fp_left": "c.is_first_person == 1 && c.item_slot == 'off_hand' && !v.kg_source_projection"
          },
          {
            "tp_right": "c.is_first_person == 0 && c.item_slot == 'main_hand'"
          },
          {
            "tp_left": "c.is_first_person == 0 && c.item_slot == 'off_hand'"
          },
          {
            "eat_right": "c.is_first_person == 1 && c.item_slot == 'main_hand' && v.kg_using_owned && !v.kg_source_projection"
          },
          {
            "eat_left": "c.is_first_person == 1 && c.item_slot == 'off_hand' && v.kg_using_owned && !v.kg_source_projection"
          },
          {
            "source_right": "c.item_slot == 'main_hand' && v.kg_source_projection"
          },
          {
            "source_left": "c.item_slot == 'off_hand' && v.kg_source_projection"
          }
        ]
      },
      "render_controllers": [
        "controller.render.kg_a22.bite"
      ],
      "animations": {
        "fp_right": "animation.kg_a287.skewer_fp_right",
        "fp_left": "animation.kg_a287.skewer_fp_left",
        "tp_right": "animation.kg_a287.skewer_tp_right",
        "tp_left": "animation.kg_a287.skewer_tp_left",
        "eat_right": "animation.kg_eating.item.two.right",
        "source_right": "animation.kg_java_eating.item.two.right",
        "eat_left": "animation.kg_eating.item.two.left",
        "source_left": "animation.kg_java_eating.item.two.left"
      }
    }
  }
}
