{
  "format_version": "1.26.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "kaleidoscope_grilling:raw_ender_pearl_skewer",
      "materials": {
        "default": "entity_alphatest_one_sided"
      },
      "textures": {
        "stage0": "textures/a22_bites/raw_ender_pearl_skewer_stage0",
        "stage1": "textures/a22_bites/raw_ender_pearl_skewer_stage1",
        "stage2": "textures/a22_bites/raw_ender_pearl_skewer_stage2",
        "stage3": "textures/a22_bites/raw_ender_pearl_skewer_stage3",
        "stage4": "textures/a22_bites/raw_ender_pearl_skewer_stage3"
      },
      "geometry": {
        "stage0": "geometry.kg_a287.kg_a22.raw_ender_pearl_skewer.stage0",
        "stage1": "geometry.kg_a287.kg_a22.raw_ender_pearl_skewer.stage1",
        "stage2": "geometry.kg_a287.kg_a22.raw_ender_pearl_skewer.stage2",
        "stage3": "geometry.kg_a287.kg_a22.raw_ender_pearl_skewer.stage3",
        "stage4": "geometry.kg_a287.kg_a22.raw_ender_pearl_skewer.stage3"
      },
      "scripts": {
        "pre_animation": [
          "v.kg_eat_seconds = (c.is_first_person == 1 ? (q.property('kaleidoscope_grilling:eat_hand') == 2 ? (q.is_using_item ? (q.property('kaleidoscope_grilling:eat_native_ticks') > 0 && q.property('kaleidoscope_grilling:eat_hand') > 0 ? math.clamp(q.property('kaleidoscope_grilling:eat_elapsed_ticks') / 20.0, 0, q.property('kaleidoscope_grilling:eat_native_ticks') / 20.0) : 0) : 0) : (q.is_using_item && q.property('kaleidoscope_grilling:eat_native_ticks') > 0 ? math.clamp((q.property('kaleidoscope_grilling:eat_native_ticks') - (q.main_hand_item_use_duration - q.frame_alpha + 1.0)) / 20.0, 0, q.property('kaleidoscope_grilling:eat_native_ticks') / 20.0) : 0)) : (q.property('kaleidoscope_grilling:eat_native_ticks') > 0 && q.property('kaleidoscope_grilling:eat_hand') > 0 ? math.clamp(q.property('kaleidoscope_grilling:eat_elapsed_ticks') / 20.0, 0, q.property('kaleidoscope_grilling:eat_native_ticks') / 20.0) : 0));",
          "v.kg_bite_stage = (q.is_using_item && ((c.item_slot == 'main_hand' && q.property('kaleidoscope_grilling:eat_hand') == 1) || (c.item_slot == 'off_hand' && q.property('kaleidoscope_grilling:eat_hand') == 2))) ? (v.kg_eat_seconds >= 3.54167 ? 3 : (v.kg_eat_seconds >= 2.33333 ? 2 : (v.kg_eat_seconds >= 0.95833 ? 1 : 0))) : 0;"
        ],
        "animate": [
          {
            "fp_right": "c.is_first_person == 1 && c.item_slot == 'main_hand'"
          },
          {
            "fp_left": "c.is_first_person == 1 && c.item_slot == 'off_hand'"
          },
          {
            "tp_right": "c.is_first_person == 0 && c.item_slot == 'main_hand'"
          },
          {
            "tp_left": "c.is_first_person == 0 && c.item_slot == 'off_hand'"
          },
          {
            "eat_right": "c.is_first_person == 1 && q.is_using_item && q.property('kaleidoscope_grilling:eat_hand') == 1 && c.item_slot == 'main_hand'"
          },
          {
            "eat_left": "c.is_first_person == 1 && q.is_using_item && q.property('kaleidoscope_grilling:eat_hand') == 2 && c.item_slot == 'off_hand'"
          }
        ]
      },
      "render_controllers": [
        "controller.render.kg_a22.bite"
      ],
      "animations": {
        "fp_right": "animation.kg_a287.skewer_fp_right",
        "fp_left": "animation.kg_a287.skewer_fp_left",
        "tp_right": "animation.kg_a287.skewer_tp_right",
        "tp_left": "animation.kg_a287.skewer_tp_left",
        "eat_right": "animation.kg_eating.item.three.right",
        "eat_left": "animation.kg_eating.item.three.left"
      }
    }
  }
}
