        "java_piece": "geometry.kg_java_dual.piece.grilled_caterpillar_skewer"
      },
      "scripts": {
        "pre_animation": [
          "v.kg_owner_eat_profile = (c.owning_entity->q.has_property('kaleidoscope_grilling:eat_profile') ? c.owning_entity->q.property('kaleidoscope_grilling:eat_profile') : 0);",
          "v.kg_owner_eat_hand = (c.owning_entity->q.has_property('kaleidoscope_grilling:eat_hand') ? c.owning_entity->q.property('kaleidoscope_grilling:eat_hand') : 0);",
          "v.kg_owner_eat_projection = (c.owning_entity->q.has_property('kaleidoscope_grilling:eat_projection') ? c.owning_entity->q.property('kaleidoscope_grilling:eat_projection') : 0);",
          "v.kg_owner_eat_native_ticks = (c.owning_entity->q.has_property('kaleidoscope_grilling:eat_native_ticks') ? c.owning_entity->q.property('kaleidoscope_grilling:eat_native_ticks') : 0);",
          "v.kg_owner_eat_elapsed_ticks = (c.owning_entity->q.has_property('kaleidoscope_grilling:eat_elapsed_ticks') ? c.owning_entity->q.property('kaleidoscope_grilling:eat_elapsed_ticks') : 0);",
          "v.kg_eat_seconds = (c.is_first_person == 1 ? (q.is_using_item && v.kg_owner_eat_hand == 2 ? (v.kg_owner_eat_native_ticks > 0 && v.kg_owner_eat_hand > 0 ? math.clamp(v.kg_owner_eat_elapsed_ticks / 20.0, 0, v.kg_owner_eat_native_ticks / 20.0) : 0) : (q.is_using_item && v.kg_owner_eat_native_ticks > 0 ? math.clamp((v.kg_owner_eat_native_ticks - (q.main_hand_item_use_duration - q.frame_alpha + 1.0)) / 20.0, 0, v.kg_owner_eat_native_ticks / 20.0) : 0)) : (v.kg_owner_eat_native_ticks > 0 && v.kg_owner_eat_hand > 0 ? math.clamp(v.kg_owner_eat_elapsed_ticks / 20.0, 0, v.kg_owner_eat_native_ticks / 20.0) : 0));",
          "v.kg_active_slot = (c.item_slot == 'main_hand' && v.kg_owner_eat_hand == 1) || (c.item_slot == 'off_hand' && v.kg_owner_eat_hand == 2);",
          "v.kg_same_item = c.item_slot == 'main_hand' ? q.is_item_name_any('slot.weapon.mainhand','kaleidoscope_grilling:grilled_caterpillar_skewer') : q.is_item_name_any('slot.weapon.offhand','kaleidoscope_grilling:grilled_caterpillar_skewer');",
          "v.kg_using_owned = q.is_using_item && v.kg_active_slot && v.kg_same_item && v.kg_owner_eat_profile == 1;",
          "v.kg_terminal_wait = c.is_first_person == 1 && !q.is_using_item && v.kg_owner_eat_native_ticks > 0 && v.kg_owner_eat_elapsed_ticks >= v.kg_owner_eat_native_ticks - 1 && v.kg_active_slot && v.kg_same_item && v.kg_owner_eat_profile == 1 && v.kg_owner_eat_projection == 1;",
          "v.kg_bite_ticks = c.is_first_person == 1 && c.item_slot == 'main_hand' ? math.clamp(v.kg_owner_eat_native_ticks - q.main_hand_item_use_duration - 1, 0, v.kg_owner_eat_native_ticks) : v.kg_owner_eat_elapsed_ticks;",
          "v.kg_bite_stage = v.kg_using_owned ? (v.kg_bite_ticks >= 62 ? 2 : (v.kg_bite_ticks >= 24 ? 1 : 0)) : 0;",
          "v.kg_source_projection = c.is_first_person == 1 && v.kg_using_owned && v.kg_owner_eat_projection == 1 && q.is_sneaking == 0 && q.is_swimming == 0 && q.is_gliding == 0 && q.is_riding == 0 && (c.item_slot == 'main_hand' ? q.is_item_equipped('off_hand') : q.is_item_equipped('main_hand')) == 0;",
          "v.kg_source_piece_scale = (v.kg_eat_seconds >= 1.16667 ? 1 : 0);",
          "v.kg_java_piece_visible = v.kg_source_projection && v.kg_source_piece_scale > 0.001;",
          "v.kg_diag_seen = v.kg_diag_seen ?? 0;",
          "v.kg_diag_main = c.is_first_person == 1 && c.item_slot == 'main_hand';",
          "v.kg_diag_marker = (v.kg_diag_marker ?? 0) || (!v.kg_diag_seen && v.kg_diag_main);",
          "(!v.kg_diag_seen && v.kg_diag_main) ? q.log(164001) : 0;",
          "v.kg_diag_seen = v.kg_diag_seen || v.kg_diag_main;",
          "v.kg_diag_armed = v.kg_diag_armed ?? 0;",
          "v.kg_diag_done = v.kg_diag_done ?? 0;",
          "v.kg_diag_rows = v.kg_diag_rows ?? 0;",
          "v.kg_diag_frame = v.kg_diag_frame ?? 0;",
          "v.kg_diag_age = v.kg_diag_age ?? 0;",
          "v.kg_diag_owner_using = c.owning_entity->q.is_using_item;",
          "v.kg_diag_armed = v.kg_diag_armed || (!v.kg_diag_done && v.kg_diag_main && (q.is_using_item || v.kg_diag_owner_using || (v.kg_owner_eat_profile == 1 && v.kg_owner_eat_hand == 1 && v.kg_owner_eat_projection == 1 && v.kg_owner_eat_native_ticks > 0)));",
          "v.kg_diag_frame = v.kg_diag_frame + (v.kg_diag_armed && !v.kg_diag_done);",
          "v.kg_diag_age = v.kg_diag_age + (v.kg_diag_armed && !v.kg_diag_done ? q.delta_time : 0);",
          "v.kg_diag_emit = v.kg_diag_armed && !v.kg_diag_done && v.kg_diag_main && v.kg_diag_rows < 300 && (v.kg_diag_rows == 0 || v.kg_diag_age >= 3.5 || !q.is_using_item);",
          "v.kg_diag_rows = v.kg_diag_rows + v.kg_diag_emit;",
          "v.kg_diag_emit ? q.log(164010) : 0;",
          "v.kg_diag_emit ? q.log(v.kg_diag_rows) : 0;",
          "v.kg_diag_emit ? q.log(v.kg_diag_frame) : 0;",
          "v.kg_diag_emit ? q.log(v.kg_diag_age) : 0;",
          "v.kg_diag_emit ? q.log(q.is_using_item) : 0;",
          "v.kg_diag_emit ? q.log(v.kg_diag_owner_using) : 0;",
          "v.kg_diag_emit ? q.log(v.kg_owner_eat_profile) : 0;",
          "v.kg_diag_emit ? q.log(v.kg_owner_eat_hand) : 0;",
          "v.kg_diag_emit ? q.log(v.kg_owner_eat_projection) : 0;",
          "v.kg_diag_emit ? q.log(v.kg_owner_eat_native_ticks) : 0;",
          "v.kg_diag_emit ? q.log(v.kg_owner_eat_elapsed_ticks) : 0;",
          "v.kg_diag_emit ? q.log(q.main_hand_item_use_duration) : 0;",
          "v.kg_diag_emit ? q.log(q.frame_alpha) : 0;",
          "v.kg_diag_emit ? q.log(v.kg_active_slot) : 0;",
          "v.kg_diag_emit ? q.log(v.kg_same_item) : 0;",
          "v.kg_diag_emit ? q.log(v.kg_using_owned) : 0;",
          "v.kg_diag_emit ? q.log(v.kg_terminal_wait) : 0;",
          "v.kg_diag_emit ? q.log(v.kg_source_projection) : 0;",
          "v.kg_diag_emit ? q.log(v.kg_bite_stage) : 0;",
          "v.kg_diag_emit ? q.log(v.kg_java_piece_visible) : 0;",
          "v.kg_diag_emit ? q.log(164011) : 0;",
          "v.kg_diag_done = v.kg_diag_done || (v.kg_diag_armed && ((!q.is_using_item && !v.kg_diag_owner_using && v.kg_owner_eat_profile == 0 && v.kg_owner_eat_hand == 0 && v.kg_owner_eat_projection == 0) || v.kg_diag_rows >= 300 || v.kg_diag_age >= 7.0));"
        ],
        "animate": [
          {
            "fp_right": "c.is_first_person == 1 && c.item_slot == 'main_hand' && !v.kg_source_projection"
          },
          {
            "fp_left": "c.is_first_person == 1 && c.item_slot == 'off_hand' && !v.kg_source_projection"
          },
          {
            "tp_right": "c.is_first_person == 0 && c.item_slot == 'main_hand'"
          },
          {
            "tp_left": "c.is_first_person == 0 && c.item_slot == 'off_hand'"
          },
          {
            "eat_right": "c.is_first_person == 1 && c.item_slot == 'main_hand' && v.kg_using_owned && !v.kg_source_projection"
          },
          {
            "eat_left": "c.is_first_person == 1 && c.item_slot == 'off_hand' && v.kg_using_owned && !v.kg_source_projection"
          },
          {
            "source_right": "c.item_slot == 'main_hand' && v.kg_source_projection"
          },
          {
            "source_left": "c.item_slot == 'off_hand' && v.kg_source_projection"
          }
        ]
      },
      "render_controllers": [
        "controller.render.kg_diagnostic.one_marker",
        "controller.render.kg_java_eating.piece"
      ],
      "animations": {
        "fp_right": "animation.kg_a287.skewer_fp_right",
        "fp_left": "animation.kg_a287.skewer_fp_left",
        "tp_right": "animation.kg_a287.skewer_tp_right",
        "tp_left": "animation.kg_a287.skewer_tp_left",
        "eat_right": "animation.kg_eating.item.one.right",
        "source_right": "animation.kg_java_eating.item.one.right",
        "eat_left": "animation.kg_eating.item.one.left",
        "source_left": "animation.kg_java_eating.item.one.left"
      }
    }
  }
