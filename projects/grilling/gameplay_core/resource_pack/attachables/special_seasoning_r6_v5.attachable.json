{
  "format_version": "1.26.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "kaleidoscope_grilling:special_seasoning_r6_v5",
      "materials": {
        "default": "entity_alphablend",
        "contents": "entity"
      },
      "textures": {
        "default": "textures/held/bottle_shell_palette"
      },
      "geometry": {
        "default": "geometry.kg_bottle_held.fixed.r6.v5"
      },
      "render_controllers": [
        "controller.render.kg_bottle_held.fixed"
      ],
      "animations": {
        "fp_right": "animation.kg_a286.bottle_fp_right",
        "tp_right": "animation.kg_a286.bottle_tp_right",
        "season_right": "animation.kg_seasoning.item.sprinkle.right",
        "tp_season_right": "animation.kg_seasoning.item.sprinkle.tp.right",
        "fp_left": "animation.kg_a286.bottle_fp_left",
        "tp_left": "animation.kg_a286.bottle_tp_left",
        "season_left": "animation.kg_seasoning.item.sprinkle.left"
      },
      "scripts": {
        "animate": [
          {
            "fp_right": "c.is_first_person == 1 && c.item_slot == 'main_hand' && ((v.kg_season_season_hand == 1 && v.kg_season_season_phase != 0)) == 0"
          },
          {
            "season_right": "c.is_first_person == 1 && c.item_slot == 'main_hand' && (v.kg_season_season_hand == 1 && v.kg_season_season_phase != 0)"
          },
          {
            "tp_right": "c.is_first_person == 0 && c.item_slot == 'main_hand' && ((v.kg_season_season_hand == 1 && v.kg_season_season_phase != 0)) == 0"
          },
          {
            "tp_season_right": "c.is_first_person == 0 && c.item_slot == 'main_hand' && (v.kg_season_season_hand == 1 && v.kg_season_season_phase != 0)"
          },
          {
            "fp_left": "c.is_first_person == 1 && c.item_slot == 'off_hand' && ((v.kg_season_season_hand == 2 && v.kg_season_season_phase != 0)) == 0"
          },
          {
            "season_left": "c.is_first_person == 1 && c.item_slot == 'off_hand' && (v.kg_season_season_hand == 2 && v.kg_season_season_phase != 0)"
          },
          {
            "tp_left": "c.is_first_person == 0 && c.item_slot == 'off_hand'"
          }
        ],
        "initialize": [
          "v.kg_season_season_hand = 0;",
          "v.kg_season_season_phase = 0;",
          "v.kg_season_pending_hand = 0;"
        ],
        "pre_animation": [
          "v.kg_season_season_hand = (c.owning_entity->q.has_property('kaleidoscope_grilling:season_hand') ? c.owning_entity->q.property('kaleidoscope_grilling:season_hand') : 0);",
          "v.kg_season_season_phase = (c.owning_entity->q.has_property('kaleidoscope_grilling:season_phase') ? c.owning_entity->q.property('kaleidoscope_grilling:season_phase') : 0);",
          "v.kg_season_pending_hand = (c.owning_entity->q.has_property('kaleidoscope_grilling:pending_hand') ? c.owning_entity->q.property('kaleidoscope_grilling:pending_hand') : 0);"
        ]
      }
    }
  }
}
